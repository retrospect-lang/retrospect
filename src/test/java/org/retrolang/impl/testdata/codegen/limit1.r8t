// test(9, 15) = 10 * (2 + 4 + 6) = 120
// test(8, 3) = 10 * 2 = 20
return [test(9, 15), test(8, 3)]

function test(n, m) =
    (0..n | limit(n-3))
    | (-> # + 1 | filter(-> (# % 2) == 0) | limit(m) | limit(m - 1))
    | ((-> # * 10) | limit(m-2) | sum)


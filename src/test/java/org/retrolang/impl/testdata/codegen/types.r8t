if prep {
  _ = test(["foo", "bar"])
}
return test(["x", True, False, [], [3, 1]])

function test(array) {
  for x in array {
    if x is Boolean {
      bools << 1
    }
    if x is String {
      strings << 1
    }
    if x is Matrix {
      arrays << 1
    }
  } collect {
    bools =| sum
    strings =| sum
    arrays =| sum
  }
  return {bools, strings, arrays}
}


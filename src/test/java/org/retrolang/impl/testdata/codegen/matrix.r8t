if prep {
  _ = test(1, 2)
}
return [test (4, 3), test(2, 0)]

function test(n, m) {
  x = matrix([n, m]) | save
  x = matrix([m, n], x) | -> (# | save) | save
  for i in 1..min(m, n) sequential x {
    x[i, i][1] = -1
  }
  return x
}


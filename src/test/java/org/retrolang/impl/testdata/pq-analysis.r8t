// Test hoisting of filters, column selection, and limits on PQCollections

// Basic test, comparisons on required and optional columns
return pqTestCollection() | filter(-> (#.i0 > 10 and #.i1 > 10)) | limit(25) | count

/* RUN () TRACE_DEPTH(1) RETURNS
0
---
⟦readPQ ∥ fileNames="test!", select="i0, i1", filter="((i0 iGT 10) and ((i1 isNull) or (i1 iGT 10)))", limit=25⟧
---
(no memory expectation)
*/

// No columns referenced
return pqTestCollection() | count

/* RUN () TRACE_DEPTH(1) RETURNS
0
---
⟦readPQ ∥ fileNames="test!", select="b0", filter=None, limit=None⟧
---
(no memory expectation)
*/

// Implicit test for presence of an optional group
return pqTestCollection() | -> #.g1 | count

/* RUN () TRACE_DEPTH(1) RETURNS
0
---
⟦readPQ ∥ fileNames="test!", select="g1.b0", filter="(g1 isNotNull)", limit=None⟧
---
(no memory expectation)
*/

// Explicit test for presence of optional column
return pqTestCollection() | filter(-> #.i1 is not Absent) | filter(-> (#.i0 > 10 and #.i1 > 10)) | count

/* RUN () TRACE_DEPTH(1) RETURNS
0
---
⟦readPQ ∥ fileNames="test!", select="i0, i1", filter="((i1 isNotNull) and (i0 iGT 10) and (i1 iGT 10))", limit=None⟧
---
(no memory expectation)
*/

// Same test, expressed as a single filter
return pqTestCollection() | filter(-> (#.i0 > 10 and #.i1 is not Absent and #.i1 > 10)) | count

/* RUN () TRACE_DEPTH(1) RETURNS
0
---
⟦readPQ ∥ fileNames="test!", select="i0, i1", filter="((i0 iGT 10) and (i1 isNotNull) and (i1 iGT 10))", limit=None⟧
---
(no memory expectation)
*/

// Explicit test is too late, so it's a no-op
return pqTestCollection() | filter(-> (#.i0 > 10 and #.i1 > 10 and #.i1 is not Absent)) | count

/* RUN () TRACE_DEPTH(1) RETURNS
0
---
⟦readPQ ∥ fileNames="test!", select="i0, i1", filter="((i0 iGT 10) and ((i1 isNull) or (i1 iGT 10)))", limit=None⟧
---
(no memory expectation)
*/

// Test for absence of non-optional column -- no row could pass.
return pqTestCollection() | filter(-> #.i0 is Absent) | count

/* RUN () TRACE_DEPTH(1) RETURNS
0
---
⟦readPQ ∥ fileNames="test!", select=None, filter=NotRead, limit=None⟧
---
(no memory expectation)
*/

// Count an optional column
return pqTestCollection() | filter(-> #.i0 == 3) | -> #.j1 | limit(12) | count

/* RUN () TRACE_DEPTH(1) RETURNS
0
---
⟦readPQ ∥ fileNames="test!", select="i0, j1", filter="((i0 iEQ 3) and (j1 isNotNull))", limit=12⟧
---
(no memory expectation)
*/

// Count an optional column, with a filter that can error
return pqTestCollection() | filter(-> #.i1 <= 3) | -> #.j1 | limit(12) | count

/* RUN () TRACE_DEPTH(1) RETURNS
0
---
⟦readPQ ∥ fileNames="test!", select="i1, j1", filter="(((i1 isNull) or (i1 iLT_EQ 3)) and ((i1 isNull) or (j1 isNotNull)))", limit=12⟧
---
(no memory expectation)
*/

// Count an optional column in an optional group
return pqTestCollection() | filter(-> #.g0.f0 < 0) | -> #.g1.d1 | count

/* RUN () TRACE_DEPTH(1) RETURNS
0
---
⟦readPQ ∥ fileNames="test!", select="g0.f0, g1.d1", filter="(((g0.f0 fEQ NaN) or (g0.f0 fLT 0.0)) and ((g0.f0 fEQ NaN) or (g1 isNull) or (g1.d1 isNotNull)))", limit=None⟧
---
(no memory expectation)
*/

// Sum an optional column in an optional group, with a filter that can't be hoisted
return pqTestCollection() | filter(-> #.g0.f0 == #.f0) | -> #.g1.d1 | limit(7) | sum

/* RUN () TRACE_DEPTH(1) RETURNS
0
---
⟦readPQ ∥ fileNames="test!", select="f0, g0.f0, g1.d1", filter="((g1 isNull) or (g1.d1 isNotNull))", limit=None⟧
---
(no memory expectation)
*/

// Switching the first filter to an inequality blocks the hoisting of the second, since the first
// could error if the column contains NaNs.
return pqTestCollection() | filter(-> #.g0.f0 < #.f0) | -> #.g1.d1 | limit(7) | sum

/* RUN () TRACE_DEPTH(1) RETURNS
0
---
⟦readPQ ∥ fileNames="test!", select="f0, g0.f0, g1.d1", filter=None, limit=None⟧
---
(no memory expectation)
*/

// Filter on the values of boolean columns
return pqTestCollection() | filter(-> (#.b0 and not #.b1 and #.g1.b0)) | -> #.g0.b1 | allTrue

/* RUN () TRACE_DEPTH(1) RETURNS
True
---
⟦readPQ ∥ fileNames="test!", select="b0, b1, g0.b1, g1.b0", filter="((b0 isTrue) and ((b1 isNull) or (b1 isFalse)) and ((b1 isNull) or (g1 isNull) or (g1.b0 isTrue)) and ((b1 isNull) or (g1 isNull) or (g0.b1 isNotNull)))", limit=None⟧
---
(no memory expectation)
*/

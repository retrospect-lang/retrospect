// Same test, but this time force the futures to run in separate threads

delayStart = testFuture
x = 1..5 | i -> future(-> fn(i + waitFor(delayStart))) | save
setTestFuture(delayStart, 0)
return waitFor(^x) | save

function fn(i) {
  // Just trace one of the subtasks to avoid non-deterministic ordering of the traces
  if i == 2 { trace }
  return i * i
}


if prep {
  _ = normTest(1)
  return normTest(2)
}
return normTest(3)

function normTest(n) {
  x = (-5..n) + n
  r1 = norm(x)
  r2 = norm(x | save)
  r3 = norm([n / 10, 0.4])
  return [r1, r2, r3]
}

function norm(v) = sqrt(v | x -> x ** 2 | sequentially(sum))


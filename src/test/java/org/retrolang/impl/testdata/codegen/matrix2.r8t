if prep {
  _ = test([1, 2, 3])
  _ = test([2, 0, 4])
}
return [test([4, 5, 6]), test([3, 4, 0])]

function test(dims) {
  zero = newMatrix(sizes(dims), 0)
  keys = matrix(dims) | -> # - 1
  return keys | sum(zero)
}


if prep {
  _ = solve(words[1..20] | save, "blush")
  return solve(words[1..50] | save, "helix")
}
return solve(words, "mauve")

function solve(words, answer) {
  potentialAnswers = words
  for idx in 1..6 sequential potentialAnswers {
   guess = bestGuess(words, potentialAnswers)
   toPrint <<^ ["Guess", idx, guess]
   response = score(guess, answer)
   toPrint <<^ ["Response:", response]
   if guess == answer {
     break
   }
   potentialAnswers = potentialAnswers | filter(-> score(guess, #) == response) | saveUnordered
   toPrint << "Answers left:"
   toPrint <<^ potentialAnswers
  } collect {
    toPrint =| saveSequential
  }
  return toPrint
}

// Get the score of this guess, given this answer.
// Returns a string with the characters "g", "y", and "-" representing
// "correct spot", "wrong spot", and "missing letter" respectively.
function score(guess, answer) {
  guess = codePoints(guess)
  answer = codePoints(answer)
  for char in 1..5 {
    // The character is in the correct spot.
    if guess[char] == answer[char] {
      result << "g"
      continue
    }
    // Let's see if it appears elsewhere in the answer.
    for otherchar in 1..5 {
      if (guess[otherchar] == answer[otherchar]) {
        continue
      }
      // How many times have we guessed this letter so far.
      if otherchar <= char and guess[otherchar] == guess[char] {
        guessed << 1
      }
      // How many times is the letter actually in the answer.
      if guess[char] == answer[otherchar] {
        actual << 1
      }
    } collect {
      guessed =| sum
      actual =| sum
    }
    // We guessed a letter that appears elsewhere in the answer.
    if guessed <= actual {
      result << "y"
    } else {
      // It isn't anywhere, or we already guessed it.
      result << "-"
    }
  } collect {
    result =| save
  }
  return join(result)
}

// Concatenate a list of strings.
function join(strings) {
  result = ""
  for char in strings sequential result {
    result = result & char
  }
  return result
}

// Calculate the best guess out of all these words given these possible answers.
// This simple algo just divides the answer space by score for each guess, and
// chooses the one that has the smallest biggest group.
function bestGuess(words, potentialAnswers) {
  if size(potentialAnswers) == 1 {
    return potentialAnswers[1]
  }
  for guess in words {
    for answer in potentialAnswers {
      groups << numFor(score(guess, answer))
      if answer == guess {
        // Give a little bonus for choosing a possible answer :-)
        possible << 1
      }
    } collect {
      groups =| intHistogram(243)
      possible =| sum
    }
    worst << (groups | max) - possible
  } collect {
    worst =| save
  }
  [[index], _] = withKeys(worst) | minAt([2])
  return words[index]
}

// A Reducer that constructs a histogram of its inputs, which must be
// integers in the range 1..size.  The histogram is returned as an array.
function intHistogram(Integer size) = IntHistogram_(size)

compound IntHistogram is Reducer
method emptyState(IntHistogram x) = newMatrix([x_], 300)
method nextState(IntHistogram, state, value) {
  state[value] += 1
  return state
}
method combineStates(IntHistogram, state1, state2) {
  state1 += state2
  return state1
}

function adjustScoreChar(char) {
  if char == 45 { // "-"
    return 0
  } else if char == 121 { // "y"
    return 1
  } else { // "g"
    return 2
  }
}

// Convert a "score" into a number between 1 and 243.
function numFor(score) {
  reduced = adjustScoreChar(^codePoints(score))
  return (([1, 3, 9, 27, 81] * reduced) | sum) + 1
}


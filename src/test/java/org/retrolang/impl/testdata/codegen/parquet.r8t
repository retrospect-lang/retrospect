table = pqCollection("yellow_tripdata_2025-02.parquet")
inFirst10 = countBigTips(table, 10)
inFirst1000 = countBigTips(table, 1000)
return { inFirst10, inFirst1000 }

// function countBigTips(table) = table | filter(-> #.tip_amount > 10) | count

function countBigTips(table, limit) {
  rowCount = 0
  bigTipCount = 0
  for tip_amount in table | row -> row.tip_amount
  sequential rowCount, bigTipCount {
    if (tip_amount > 10) {
      bigTipCount += 1
    }
    rowCount += 1
    if rowCount == limit { break }
  }
  return bigTipCount
}


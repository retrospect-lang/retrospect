if prep {
  assert test(2, 4) == 12  // 1*1 + 2*2 + 4*0 + 3*1 + 2*2 + 1*0
  assert test(0, 3) == 7   // 3*1 + 2*2 * 1*0
}
return [test(4, 5),   // 1*1 + 2*2 + 3*0 + 4*1 + 5*2 + 4*0 + 3*1 + 2*2 + 1*0
        test(0, 5)]   // 5*1 + 4*2 * 3*0 + 2*1 * 1*2

function test(m, n) {
  x = 1..m & reverse(1..n)
  y = 1..(m + n) | -> # % 3
  return x * y | sum
}

